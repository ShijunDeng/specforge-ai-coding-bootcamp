{
  "name": "shendeng-ai-training-slides",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --success first --names portal,ai-coding \"npm:dev:portal\" \"npm:dev:ai-coding\"",
    "dev:portal": "vite --config vite.portal.config.ts --host 0.0.0.0 --port 3030",
    "dev:ai-coding": "slidev courses/ai-coding/slides.md --port 3031 --base /ai-coding/",
    "build": "npm run build:portal && npm run build:ai-coding",
    "build:portal": "vite build --config vite.portal.config.ts",
    "build:ai-coding": "slidev build courses/ai-coding/slides.md --base /ai-coding/ --out ../../dist/ai-coding",
    "preview": "vite preview --config vite.portal.config.ts --host 0.0.0.0 --port 3030",
    "export": "npm run export:ai-coding",
    "export:ai-coding": "slidev export courses/ai-coding/slides.md",
    "mcp": "npm run mcp:ai-coding",
    "mcp:ai-coding": "slidev mcp courses/ai-coding/slides.md"
  },
  "dependencies": {
    "@slidev/cli": "^52.18.0",
    "@slidev/theme-default": "^0.25.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright-chromium": "^1.63.0",
    "vite": "^8.1.5"
  }
}
